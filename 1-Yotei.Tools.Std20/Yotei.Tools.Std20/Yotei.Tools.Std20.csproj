<!--
This is an example project to show how to import 'Yotei.Tools' for a .NET Standard 2.0 environment
such as source code generators ones.
- NETSTANDARD2_0 must be defined (which is a must for source code generators).
- Instead of referencing the package, we just 'import' as links the relevant files.
-->
<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Configurations>Debug;Release;Local</Configurations>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>preview</LangVersion>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<NoWarn>IDE0130</NoWarn>
	</PropertyGroup>
	<!--IDE0130: Namespace does not match folder structure-->

</Project>
