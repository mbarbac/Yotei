<!--
This project is architected to test elements of 'Yotei.Tools' under .NET Standard 2.0 conditions,
such as those found in source code generation projects.

For these scenarios:
- The 'NETSTANDARD2_0' compilation symbol must be defined.
- Instead of referencing the 'Yotei.Tools' project or package, the files under its 'Standard'
  folder shall be link-imported as shown below. This way, they become part of the solution under
  their own 'Yotei.Tools.Std20' namespace.

Considerations:
- Extension blocks are only supported from c# 14 and .NET 10... so as they are not strictly
  technical neccesary, its better to avoid them.

In addition, only for testing purposes and only for this project:
- We use a legacy framework that emulates that environment.
- We reference the latest stable Xunit packages for that framework.
-->
<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netcoreapp3.1</TargetFramework>
		<RollForward>Major</RollForward>
		<Configurations>Debug;Release;Local</Configurations>		
		<LangVersion>preview</LangVersion>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<NoWarn>IDE0130</NoWarn>
	</PropertyGroup>
	<!--IDE0130: Namespace does not match folder structure-->

	<!--Latests versions compatible with NETStandard 2.0-->
	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.4.0" />
		<PackageReference Include="xunit" Version="2.4.2" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.4.5">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>

	<PropertyGroup>
		<DefineConstants>$(DefineConstants);NETSTANDARD2_0</DefineConstants>
		<ToolsPath>..\..\1-Yotei.Tools\Yotei.Tools</ToolsPath>
		<TestsPath>..\..\1-Yotei.Tools\Yotei.Tools.Tests</TestsPath>
	</PropertyGroup>
	<ItemGroup>
		<Compile
			Include="$(ToolsPath)\Standard\**\*.cs"
			Exclude="(ToolsPath)\Standard\**\obj\**;(ToolsPath)\Exported\**\bin\**">
			<Link>Tools\%(RecursiveDir)%(FileName)%(Extension)</Link>
		</Compile>
		<Compile
			Include="$(TestsPath)\Standard\**\*.cs"
			Exclude="(TestsPath)\Standard\**\obj\**;(ToolsPath)\Exported\**\bin\**">
			<Link>Tests\%(RecursiveDir)%(FileName)%(Extension)</Link>
		</Compile>
	</ItemGroup>

</Project>