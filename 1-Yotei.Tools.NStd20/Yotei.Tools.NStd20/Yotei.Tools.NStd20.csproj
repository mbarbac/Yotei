<!--
This project is NOT intended to be a packaged one.
Rather, it is intended to:
	- Serve as code source for the 'Yotei.Tools' in a NET Standard 2.0 environment,
	- Serve as code source for the Yotei's source code generators utilities.
-->
<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Configurations>Debug;Release;Local</Configurations>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>preview</LangVersion>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<NoWarn>IDE0130</NoWarn>
	</PropertyGroup>
	<!--IDE0130: Namespace does not match folder structure-->

	<PropertyGroup>
		<ToolsPath>..\..\1-Yotei.Tools\Yotei.Tools</ToolsPath>
	</PropertyGroup>
	<ItemGroup>
		<Compile
			Include="$(ToolsPath)\NStandard\**\*.cs"
			Exclude="$(ToolsPath)\NStandard\**\obj\**;(ToolsPath)\NStandard\**\bin\**">
			<Link>Yotei.Tools\%(RecursiveDir)%(FileName)%(Extension)</Link>
		</Compile>
	</ItemGroup>

</Project>
