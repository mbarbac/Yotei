<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Configurations>Debug;Release;Local</Configurations>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>preview</LangVersion>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<NoWarn>IDE0130;CS0579</NoWarn>
	</PropertyGroup>
	<!--IDE0130: Namespace does not match folder structure-->

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
		<PackageReference Include="xunit.v3" Version="4.0.2" />
		<PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="coverlet.collector" Version="10.1.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<PropertyGroup>
		<DefineConstants>$(DefineConstants);YOTEI_TOOLS_GENERATORS</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<Compile
			Include="..\Yotei.Tools\Exported\**\*.cs"
			Exclude="..\Yotei.Tools\Exported\**\obj\**;..\Yotei.Tools\Exported\**\bin\**">
			<Link>Tools\%(RecursiveDir)%(FileName)%(Extension)</Link>
		</Compile>
		<Compile
			Include="..\Yotei.Tools.Tests\Exported\**\*.cs"
			Exclude="..\Yotei.Tools.Tests\Exported\**\obj\**;..\Yotei.Tools.Tests\Exported\**\bin\**">
			<Link>Tests\%(RecursiveDir)%(FileName)%(Extension)</Link>
		</Compile>
	</ItemGroup>

</Project>