<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Configurations>Debug;Release;Local</Configurations>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>preview</LangVersion>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<NoWarn>IDE0130</NoWarn>
	</PropertyGroup>
	<!--IDE0130: Namespace does not match folder structure-->

	<PropertyGroup>
		<Description>Yotei Common Tools for NET Standard 2.0 environments.</Description>
		<Version>0.7.2-v0001</Version>
		<Authors>mbarbac@hotmail.com</Authors>
		<IsPackable>true</IsPackable>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<RepositoryUrl>https://github.com/mbarbac/Yotei</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
	</PropertyGroup>
	<ItemGroup>
		<None Include="..\..\LICENSE" Pack="true" PackagePath="\" Link="LICENSE" />
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
	
	<ItemGroup>
		<PackageReference Include="System.Memory" Version="4.6.3" />
	</ItemGroup>
	
	<!--Used to import the appropriate source code files-->
	<PropertyGroup>
		<DefineConstants>$(DefineConstants);NETSTANDARD2_0</DefineConstants>
		<ToolsPath>..\..\1-Yotei.Tools\Yotei.Tools</ToolsPath>
	</PropertyGroup>
	<ItemGroup>
		<Compile
			Include="$(ToolsPath)\NStandard\**\*.cs"
			Exclude="$(ToolsPath)\NStandard\**\obj\**;(ToolsPath)\NStandard\**\bin\**">
			<Link>Yotei.Tools\%(RecursiveDir)%(FileName)%(Extension)</Link>
		</Compile>
	</ItemGroup>

</Project>
